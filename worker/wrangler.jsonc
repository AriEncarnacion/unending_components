// The Unending registry Worker. Deploy steps and account settings are in README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unending-registry",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Served only at the custom domain: no workers.dev URL, no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "registry.unending.studio", "custom_domain": true }],
  "r2_buckets": [{ "binding": "REGISTRY", "bucket_name": "unending-registry" }],
  // Alerts go to a verified Email Routing destination, set as the ALERT_TO secret.
  "send_email": [{ "name": "ALERTS" }],
  "vars": {
    "GITHUB_REPOSITORY": "AriEncarnacion/unending_components",
    "GITHUB_REPOSITORY_ID": "1467395964",
    "OIDC_AUDIENCE": "https://registry.unending.studio",
    "ALERT_FROM": "registry@unending.studio",
    // The registry's own OAuth app (device flow on, no secret needed). Set it once the app exists.
    "GITHUB_CLIENT_ID": ""
  },
  // Secrets (wrangler secret put): ADMIN_KEYS, TOKEN_ENC_KEY, ALERT_TO.
  // Off: invocation logs record request details, and the registry must never keep
  // Authorization headers. Use `wrangler tail` to debug.
  "observability": { "enabled": false }
}
