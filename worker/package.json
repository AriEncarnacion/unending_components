{
  "name": "unending-registry",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787 --local-upstream 127.0.0.1:8787",
    "deploy": "wrangler deploy",
    "test": "vitest run && vitest run --root backup",
    "typecheck": "tsc --noEmit",
    "deploy:backup": "wrangler deploy --config backup/wrangler.jsonc"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "@cloudflare/workers-types": "5.20261106.1",
    "aws4fetch": "1.0.20",
    "typescript": "5.9.3",
    "vitest": "5.1.1",
    "wrangler": "4.158.0"
  }
}
