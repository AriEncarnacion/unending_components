// The registry backup Worker. Deploy it to a SECOND Cloudflare account (see ../README.md).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "unending-registry-backup",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["17 * * * *"] },
  "r2_buckets": [{ "binding": "BACKUP", "bucket_name": "unending-registry-backup" }],
  "vars": { "SOURCE_BUCKET": "unending-registry", "SOURCE_ACCOUNT_ID": "" },
  // Secrets: SOURCE_ACCESS_KEY_ID, SOURCE_SECRET_ACCESS_KEY (read-only on the registry bucket).
  "observability": { "enabled": true }
}
