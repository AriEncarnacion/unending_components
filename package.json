{
  "name": "unending-components",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "registry:theme": "node scripts/sync-theme.mjs",
    "registry:index": "node scripts/build-catalog-index.mjs",
    "registry:build": "node scripts/sync-theme.mjs && node scripts/build-catalog-index.mjs && npm run registry:systems",
    "registry:check": "node scripts/sync-theme.mjs --check && node scripts/build-catalog-index.mjs --check && npm run registry:systems && shadcn registry validate",
    "registry:systems": "node --experimental-strip-types --no-warnings scripts/build-systems.ts",
    "up": "node scripts/start.mjs",
    "audit:sizes": "node plugin/skills/unending-size-audit/scripts/audit-sizes.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.24.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
