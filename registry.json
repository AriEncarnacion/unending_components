      "dependencies": [
        "lucide-react"
      ],
      "registryDependencies": [
        "collapsible",
        "sidebar",
        "AriEncarnacion/unending_components/tuning",
        "AriEncarnacion/unending_components/theme"
      ],
      "files": [
        {
          "path": "registry/unending/page-nav/page-nav.tsx",
          "type": "registry:component"
        }
      ],
      "docs": "Render PageNav inside SidebarProvider, next to SidebarInset. Pass currentPath and renderLink from your router. renderLink must spread every prop onto the link, or the active styling and aria-current are lost.",
      "meta": {
        "entry": true,
        "intent": "Move between the pages of an app and always know where you are.",
        "status": "draft",
        "origin": "Designed from intent on the stock shadcn sidebar"
      }
    },
