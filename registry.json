    {
      "name": "font-sans",
      "type": "registry:font",
      "title": "DM Sans (body)",
      "description": "The catalog's body and UI font, as --font-sans.",
      "font": {
        "family": "'DM Sans Variable', sans-serif",
        "provider": "google",
        "import": "DM_Sans",
        "variable": "--font-sans",
        "subsets": [
          "latin"
        ],
        "dependency": "@fontsource-variable/dm-sans"
      }
    },
    {
      "name": "font-heading",
      "type": "registry:font",
      "title": "Manrope (headings)",
      "description": "The catalog's heading font, as --font-heading. Used by h1-h6 and stock titles (font-heading).",
      "font": {
        "family": "'Manrope Variable', sans-serif",
        "provider": "google",
        "import": "Manrope",
        "variable": "--font-heading",
        "subsets": [
          "latin"
        ],
        "dependency": "@fontsource-variable/manrope"
      }
    },
    {
      "name": "font-mono",
      "type": "registry:font",
      "title": "Geist Mono (code and data)",
      "description": "The catalog's monospace font, as --font-mono.",
      "font": {
        "family": "'Geist Mono Variable', monospace",
        "provider": "google",
        "import": "Geist_Mono",
        "variable": "--font-mono",
        "subsets": [
          "latin"
        ],
        "dependency": "@fontsource-variable/geist-mono"
      }
    },
    {
      "name": "tuning",
      "type": "registry:lib",
      "title": "Entry tuning hook",
      "description": "useEntryTuning: an entry's feel values (durations, distances, defaults). Returns the defaults outside the catalog; design-system installs replace it with plain values.",
      "files": [
        {
          "path": "lib/tuning.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "timeline-scrubber",
      "type": "registry:component",
      "title": "Timeline Scrubber",
      "description": "See who or what occupies parallel lanes around a moment, and drag, flick or key that moment through time. Built for on-call rotations, bookings and other schedules where each moment has one owner per lane.",
      "categories": [
        "time",
        "scheduling"
      ],
      "dependencies": [
        "cn",
        "lucide-react"
      ],
      "registryDependencies": [
        "badge",
        "button",
        "slider",
        "tooltip",
        "AriEncarnacion/unending_components/tuning",
        "AriEncarnacion/unending_components/theme"
      ],
      "files": [
        {
          "path": "registry/unending/timeline-scrubber/timeline-scrubber.tsx",
          "type": "registry:component"
        }
      ],
      "docs": "Wrap your app in TooltipProvider. Exports TimelineScrubber and withOverrides.",
      "meta": {
        "entry": true,
        "intent": "See who or what occupies parallel lanes around a moment, and move that moment through time.",
        "status": "draft",
        "origin": "Harvested from Bearing's support shift scrubber"
      }
    },
    {
      "name": "agent-chat",
      "type": "registry:component",
      "title": "Agent Chat",
      "description": "Read an AI agent's markdown answer while it streams (tables, highlighted code, task lists) and reply. Status values mirror the AI SDK's useChat.",
      "categories": [
        "ai",
        "conversation"
      ],
      "dependencies": [
        "cn",
        "lucide-react",
        "react-markdown@^10.1.0",
        "remark-gfm@^4.0.1"
      ],
      "registryDependencies": [
        "bubble",
        "code-block",
        "input-group",
        "marker",
        "message",
        "message-scroller",
        "spinner",
        "AriEncarnacion/unending_components/tuning",
        "AriEncarnacion/unending_components/theme"
      ],
      "files": [
        {
          "path": "registry/unending/agent-chat/agent-chat.tsx",
          "type": "registry:component"
        },
        {
          "path": "registry/unending/agent-chat/chat-markdown.tsx",
          "type": "registry:component"
        }
      ],
      "docs": "Exports AgentChat. ChatMarkdown is exported from chat-markdown for rendering agent text elsewhere.",
      "meta": {
        "entry": true,
        "intent": "Read an AI agent's answer as it streams, with full formatting, and reply.",
        "status": "draft",
        "origin": "Designed from intent, composed from shadcn AI parts"
      }
    },
    {
      "name": "review-deck",
      "type": "registry:component",
      "title": "Review Deck",
      "description": "Work through a stack of yes/no decisions one card at a time, with a third \"later\" exit. Drag, button or key; async saves with retry; caller-owned queue and undo.",
      "categories": [
        "decisions",
        "review"
      ],
      "dependencies": [
        "cn",
        "lucide-react"
      ],
      "registryDependencies": [
        "button",
        "card",
        "empty",
        "kbd",
        "AriEncarnacion/unending_components/tuning",
        "AriEncarnacion/unending_components/theme"
      ],
      "files": [
        {
          "path": "registry/unending/review-deck/review-deck.tsx",
          "type": "registry:component"
        }
      ],
      "docs": "Give the deck's parent an explicit height. The queue is controlled: remove items[0] once onDecision succeeds. Exports ReviewDeck, createReviewActions and classifyGesture.",
      "meta": {
        "entry": true,
        "intent": "Work through a stack of yes-or-no decisions quickly, with a way to put one off for later.",
        "status": "draft",
        "origin": "Restyled from the @review-deck/react package (MIT)"
      }
    },
    {
      "name": "page-nav",
      "type": "registry:component",
      "title": "Page Navigation",
      "description": "Move between the pages of an app: grouped pages with badges and sub-pages, current page marked and its group opened, a filter for long lists, collapse to icons, and any router via renderLink.",
      "categories": [
        "navigation",
        "app shell"
